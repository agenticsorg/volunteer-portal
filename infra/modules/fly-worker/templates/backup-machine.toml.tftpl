# Generated by Terraform (infra/modules/fly-worker) - do not edit by hand,
# edit templates/backup-machine.toml.tftpl instead.
#
# ADR-0016: "a small script that shells out to `pg_dump $DATABASE_URL |
# gzip | aws s3 cp - s3://... ` pointed at R2's S3-compatible endpoint
# using R2 API credentials". DATABASE_URL, R2_ENDPOINT and the
# R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY the `aws` CLI needs are Fly
# secrets (see this module's null_resource.fly_secrets), not baked into
# this file.
app = "${app_name}"

[processes]
  backup = "/bin/sh -c 'pg_dump \"$DATABASE_URL\" | gzip | aws s3 cp - s3://${r2_bucket_name}/pg_dump-$(date +%Y%m%dT%H%M%SZ).sql.gz --endpoint-url \"$R2_ENDPOINT\"'"

[[vm]]
  size = "shared-cpu-1x"
