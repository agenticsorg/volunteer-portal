# Generated by Terraform (infra/modules/fly-worker) - do not edit by hand,
# edit templates/fly.toml.tftpl instead.
#
# ADR-0016 Implementation Notes: "Fly.io worker app:
# infra/modules/fly-worker/fly.toml template with [processes] worker =
# "node dist/worker.js"". apps/worker (this repo, as of Phase 10) runs via
# `tsx src/index.ts` in dev and has neither a build script producing
# dist/worker.js nor a production Dockerfile yet - the command below
# matches the ADR's intended shape for when that build step exists.
# Provisioning this for real also needs `apps/worker/Dockerfile` added,
# which is outside this Terraform-only stage's scope.
app = "${app_name}"
primary_region = "${primary_region}"

[build]
  dockerfile = "../../apps/worker/Dockerfile"

[processes]
  worker = "node dist/worker.js"

[[vm]]
  size = "${vm_size}"

[deploy]
  strategy = "rolling"

[env]
  NODE_ENV = "${environment}"
