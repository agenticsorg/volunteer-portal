# Agentics Foundation Volunteer Portal — environment variables
#
# Copy this file to `.env` (repo root) for local development. `.env` is
# gitignored — never commit real values. `docker-compose.yml` reads the
# POSTGRES_* vars directly; `pnpm db:*` scripts load this same file via
# `dotenv-cli` so Prisma sees DATABASE_URL when run from apps/web.

# --- Database (ADR-0004: single Postgres 15+ instance, Prisma multi-schema) ---

# Local dev: matches docker-compose.yml's postgres service (`pnpm db:up`).
# Staging/production use a managed Neon connection string (ADR-0016) — not
# set here; those are configured as Vercel environment variables.
DATABASE_URL="postgresql://volunteer_portal:volunteer_portal@localhost:5432/volunteer_portal?schema=public"

# Credentials for the local docker-compose Postgres container. Must match
# the credentials embedded in DATABASE_URL above.
POSTGRES_USER="volunteer_portal"
POSTGRES_PASSWORD="volunteer_portal"
POSTGRES_DB="volunteer_portal"
POSTGRES_PORT="5432"

# --- Auth (ADR-0006: Supabase Auth for identity and session management) ---
#
# Local dev: the Supabase CLI's local stack (`pnpm supabase:start`), which
# runs its own Postgres + GoTrue + Kong entirely inside Docker, separate
# from the app's own docker-compose Postgres above. `pnpm supabase:status`
# prints the real values for a running local stack — copy ANON_KEY and
# API_URL from there; the values below are this repo's *default* local
# stack config (supabase/config.toml pins the API port to 54321) and only
# need to change if that config changes.
#
# To point this app at a real, hosted Supabase project later (including an
# eventual hire.agentics.org SSO federation — explicitly deferred, see
# ADR-0006) swap ONLY these two values for the project's own URL and anon
# key from its API settings page. No code in `src/` reads a local-stack
# URL/key directly — every file goes through `getSupabaseAuthEnv()`
# (apps/web/src/server/auth/env.ts), so this config swap is the entire
# migration; nothing else changes.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"
