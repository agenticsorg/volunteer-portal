# Local development / CI. In production this points at a Neon Postgres
# branch (ADR-0003); Neon connection strings are provisioned outside this
# repo and are not committed here.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/volunteer_portal

# Non-owner application role (ADR-0004: the app's DB role must not be a
# table owner, so RLS cannot be silently bypassed). Created by migration
# 0004; the password below is a local-dev-only default — production must
# set a real secret via Neon's role management, never this value.
APP_DB_ROLE=app_user
APP_DB_ROLE_PASSWORD=app_user_dev_password
APP_DATABASE_URL=postgres://app_user:app_user_dev_password@127.0.0.1:5432/volunteer_portal

# Discord OAuth (ADR-0007) - unavailable in this environment; placeholder.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=

# Google OIDC (ADR-0007) - unavailable in this environment; placeholder.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postmark (ADR-0010) - unavailable in this environment; placeholder.
POSTMARK_SERVER_TOKEN=
