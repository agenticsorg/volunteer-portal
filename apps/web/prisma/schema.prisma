// Agentics Foundation Volunteer Portal — Prisma schema
//
// Phase 0 (platform bootstrap): multi-schema mode wiring only. This
// declares the eight bounded-context Postgres schemas from
// docs/ddd/00-context-map.md (ADR-0001) so the baseline migration can
// create them — no models/tables yet. Domain modeling starts in later
// phases; do not add models here as part of Phase 0.
//
// Prisma's multi-schema mode has been GA since Prisma 6 (ADR-0004), so no
// `previewFeatures` entry is required for it on this Prisma 6.19.3 install.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "volunteering", "training", "gamification", "community", "moderation", "notifications", "admin"]
}

// ---------------------------------------------------------------------------
// Phase 1 — Event Backbone & Platform Audit Log
// ---------------------------------------------------------------------------
//
// `<schema>.domain_events` — the standard transactional-outbox table shape
// (ADR-0009), established once here as the model every bounded context
// replicates in its own schema starting the next implementation phase. The
// column set is intentionally the minimal shape needed for this phase's
// outbox-drain worker (`audit_log_writer`): `id` (ULID, chronologically
// sortable — ADR-0005), `aggregateType`, `aggregateId`, `eventType`,
// `payload` (jsonb), `occurredAt`, `processedAt`, `attempts`. ADR-0009's own
// sketch additionally shows `dispatched_at`/`last_error` and a companion
// `domain_event_dispatches` table for the full multi-subscriber relay
// mechanism — deliberately deferred: this phase only needs single-consumer
// (`audit_log_writer`) drain semantics, and the fuller relay bookkeeping
// lands with the first real subscriber-fan-out use case.
//
// Added for real, identically, to all eight schemas now (rather than once
// per phase as each bounded context is built) because: (1) every context
// needs this exact shape eventually per ADR-0009, so doing it eight times
// later is pure repetition of this same migration step; (2) the
// `audit_log_writer` job below is specified to drain *every* schema's
// outbox, so having all eight tables live now lets this phase's own
// verification exercise the real multi-schema drain path instead of a
// single throwaway stand-in. Prisma has no schema-level "fragment"/mixin
// mechanism, so the eight models below are intentionally identical copies —
// keep them in sync by hand if this shape ever changes before every
// bounded context has replaced its copy with real domain-specific event
// handling.
//
// Each table also gets a partial index on `processed_at IS NULL`
// (ADR-0009's own sketch) for efficient drain-worker polling. Prisma's
// schema language has no partial-index syntax, so those indexes are added
// by hand in the migration SQL only and intentionally have no `@@index`
// counterpart here — same hand-authored-extra-DDL precedent as the Phase 0
// baseline migration's `CREATE SCHEMA` statements.

model IdentityDomainEvent {
  id            String    @id
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
  attempts      Int       @default(0)

  @@map("domain_events")
  @@schema("identity")
}

