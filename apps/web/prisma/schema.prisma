// ---------------------------------------------------------------------------
// Phase 2 — Identity & Access: data model only
// ---------------------------------------------------------------------------
//
// The Person, Chapter, RoleAssignment, ConsentRecord, and DSARRequest
// aggregates from docs/ddd/identity-access.md, matching the Schema Sketch in
// docs/ddd/identity-access-schema-api.md field-for-field. No use cases, no
// API, no auth in this phase — the migration this schema drives is data
// model only.
//
// Postgres enum types back four columns exactly as the Schema Sketch
// specifies (identity.role_name, identity.scope_type,
// identity.consent_purpose, identity.dsar_type, identity.dsar_status).
// `chapters.status`, `persons.status`, and `consent_records.source` are
// deliberately plain `text` + `CHECK (... IN (...))` in the sketch, not
// enums — modeled the same way here (String, not a Prisma enum) so the
// generated DDL matches exactly; the CHECK constraints themselves have no
// Prisma-schema-language equivalent (no stable `@@check` attribute in this
// Prisma version) and are hand-authored in the migration SQL, same
// precedent as this file's existing partial indexes and triggers.
//
// `Chapter.leadPersonId` is an intentional soft reference (no relation, no
// FK) per the sketch's own comment: avoids a circular creation dependency
// between Chapter and Person, validated at the `AssignChapterLead`
// application-layer use case instead (not built in this phase).
// `RoleAssignment.scopeId` is similarly a plain, unrelated column — it
// points at either `chapters.id` (same schema) or a Community-context team
// ID (a different, not-yet-built schema), so no single FK could express it
// even if one were wanted; enforced app-side only, per ADR-0008.

enum IdentityRoleName {
  volunteer
  mentor
  chapter_lead
  content_admin
  org_admin
  moderator

  @@map("role_name")
  @@schema("identity")
}

enum IdentityScopeType {
  global
  chapter
  team

  @@map("scope_type")
  @@schema("identity")
}

enum IdentityConsentPurpose {
  terms_of_service
  newsletter
  photo_publication
  leaderboard_participation
  analytics_cookies
  guardian_consent

  @@map("consent_purpose")
  @@schema("identity")
}

enum IdentityDsarType {
  export
  erasure

  @@map("dsar_type")
  @@schema("identity")
}

enum IdentityDsarStatus {
  pending
  processing
  completed
  failed

  @@map("dsar_status")
  @@schema("identity")
}

// Chapters are created before Persons to avoid a circular FK; the reverse
// pointer (`leadPersonId`) is intentionally a soft reference — see the
// header note above and ADR-0008 (Chapter is a domain entity, not a tenant
// boundary).
model Chapter {
  id           String    @id
  name         String
  slug         String    @unique
  city         String
  region       String?
  country      String
  status       String    @default("active")
  foundedAt    DateTime? @map("founded_at") @db.Date
  leadPersonId String?   @map("lead_person_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  persons Person[]

  @@index([status], map: "idx_chapters_status")
  @@map("chapters")
  @@schema("identity")
}

model Person {
  id                String    @id
  publicSlug        String    @unique @map("public_slug")
  supabaseAuthId    String    @unique @map("supabase_auth_id")
  email             String    @unique @db.Citext
  displayName       String    @map("display_name")
  pronouns          String?
  avatarUrl         String?   @map("avatar_url")
  bio               String?
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  ageAttested16Plus Boolean   @default(false) @map("age_attested_16_plus")
  primaryChapterId  String?   @map("primary_chapter_id")
  status            String    @default("active")
  anonymizedAt      DateTime? @map("anonymized_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  primaryChapter Chapter? @relation(fields: [primaryChapterId], references: [id])

  roleAssignmentsAsSubject RoleAssignment[] @relation("RoleAssignmentSubject")
  roleAssignmentsGranted   RoleAssignment[] @relation("RoleAssignmentGrantedBy")
  roleAssignmentsRevoked   RoleAssignment[] @relation("RoleAssignmentRevokedBy")
  consentRecords           ConsentRecord[]
  dsarRequestsAsSubject    DSARRequest[]    @relation("DSARRequestSubject")
  dsarRequestsRequested    DSARRequest[]    @relation("DSARRequestRequestedBy")

  @@index([primaryChapterId], map: "idx_persons_chapter")
  @@index([status], map: "idx_persons_status")
  @@map("persons")
  @@schema("identity")
}

model RoleAssignment {
  id        String            @id
  subjectId String            @map("subject_id")
  role      IdentityRoleName
  scopeType IdentityScopeType @default(global) @map("scope_type")
  scopeId   String?           @map("scope_id")
  grantedBy String            @map("granted_by")
  grantedAt DateTime          @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedBy String?           @map("revoked_by")
  revokedAt DateTime?         @map("revoked_at") @db.Timestamptz(6)

  subject Person  @relation("RoleAssignmentSubject", fields: [subjectId], references: [id])
  granter Person  @relation("RoleAssignmentGrantedBy", fields: [grantedBy], references: [id])
  revoker Person? @relation("RoleAssignmentRevokedBy", fields: [revokedBy], references: [id])

  @@map("role_assignments")
  @@schema("identity")
}

model ConsentRecord {
  id            String                 @id
  personId      String                 @map("person_id")
  purpose       IdentityConsentPurpose
  granted       Boolean
  policyVersion String                 @map("policy_version")
  source        String
  guardianName  String?                @map("guardian_name")
  guardianEmail String?                @map("guardian_email") @db.Citext
  recordedAt    DateTime               @default(now()) @map("recorded_at") @db.Timestamptz(6)
  revokedAt     DateTime?              @map("revoked_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [id])

  @@index([personId, purpose, recordedAt(sort: Desc)], map: "idx_consent_records_person_purpose")
  @@map("consent_records")
  @@schema("identity")
}

model DSARRequest {
  id            String             @id
  personId      String             @map("person_id")
  type          IdentityDsarType
  status        IdentityDsarStatus @default(pending)
  requestedBy   String             @map("requested_by")
  requestedAt   DateTime           @default(now()) @map("requested_at") @db.Timestamptz(6)
  completedAt   DateTime?          @map("completed_at") @db.Timestamptz(6)
  exportFileUrl String?            @map("export_file_url")
  failureReason String?            @map("failure_reason")

  subject   Person @relation("DSARRequestSubject", fields: [personId], references: [id])
  requester Person @relation("DSARRequestRequestedBy", fields: [requestedBy], references: [id])

  @@index([personId], map: "idx_dsar_requests_person")
  @@map("dsar_requests")
  @@schema("identity")
}

// `admin.audit_log` — the single, platform-wide privileged-action audit
// trail (ADR-0014 §4; docs/ddd/admin-reporting.md "There is one audit log,
// not two"). Populated exclusively by the `audit_log_writer` graphile-worker
// job draining every schema's `domain_events` outbox for `audit: true`
// payloads — never written to directly by application code, which is what
// makes the insert-only enforcement below meaningful.
//
// `ip_address inet` (ADR-0014's exact column spec) is modeled as
// `Unsupported("inet")` because Prisma has no native `inet` scalar. Two
// consequences worth knowing, both verified while building this
// migration:
//   - It's excluded from the generated Prisma Client's typed
//     create/update API (Prisma's documented behavior for `Unsupported`
//     fields) — not populated by this phase's drain worker anyway
//     (request-context capture is a later concern), and any future write
//     to it goes through `$executeRaw`.
//   - Prisma's migration-diff engine cannot fully round-trip
//     `Unsupported()` native types: every future `prisma migrate dev` /
//     `migrate diff` against this table proposes a no-op
//     `ALTER COLUMN ip_address SET DATA TYPE inet` (same type, no data
//     loss — confirmed by reproducing it, not a guess). This is the
//     lesser of two evils versus the alternative (leaving the column
//     unmodeled entirely), which was also tried and instead produces a
//     recurring `DROP COLUMN ip_address` proposal — genuinely dangerous
//     if a future `migrate dev` run is accepted without reading the diff.
//     Always read what `migrate dev`/`migrate diff` proposes against
//     `admin.audit_log` before applying; a same-type no-op ALTER is
//     expected and safe to accept, a DROP COLUMN never is.
// ---------------------------------------------------------------------------
// Phase 3 — Volunteering & Opportunities: data model only
// ---------------------------------------------------------------------------
//
// The Opportunity, Shift, Application, and HourEntry aggregates from
// docs/ddd/volunteering-opportunities.md, matching the Schema Sketch in
// docs/ddd/volunteering-opportunities-schema-api.md field-for-field. All
// four live in the `volunteering` schema and use real foreign keys between
// each other — the no-cross-schema-FK rule (ADR-0001) applies only at
// bounded-context boundaries, not within one. `volunteering.domain_events`
// (`VolunteeringDomainEvent`, above) already exists from Phase 1; this
// phase only adds the four aggregate tables. No use cases, no API in this
// phase — the migration this schema drives is data model only.
//
// `chapter_id`, `prerequisite_course_ids`, `created_by_person_id`,
// `applicant_person_id`, `decided_by_person_id`, `person_id`, and
// `approver_person_id` are all intentional soft references (plain columns,
// no relation, no FK) to `identity.persons.id` / `identity.chapters.id` /
// `training.courses.id` — cross-schema, so no FK is possible or wanted, per
// the Schema Sketch's own comments and ADR-0001.
//
// Several constructs in the Schema Sketch have no Prisma-schema-language
// equivalent and are hand-authored in the migration SQL instead — same
// precedent as every hand-authored addition already in this file's earlier
// phases:
//   - The `chk_opportunities_publish`, `chk_shifts_time_order`,
//     `chk_shifts_capacity`, `chk_hour_entries_time_order`,
//     `chk_hour_entries_duration`, `chk_hour_entries_approval`, and
//     `chk_hour_entries_no_self_approval` CHECK constraints (no stable
//     `@@check` attribute in this Prisma version).
//   - `uq_applications_active_per_shift`, the partial unique index enforcing
//     Application invariant 1 ("at most one non-terminal/accepted
//     Application per (applicant, shift)") — Prisma's schema language has
//     no partial-index syntax.
//   - `idx_hour_entries_approved_export`, the partial index on
//     `approved_at WHERE status = 'approved'` backing the grant-export hot
//     path — same reason.
//   - The `prevent_approved_hour_entry_mutation()` trigger function and its
//     `trg_hour_entries_immutable` trigger (ADR-0014: HourEntry invariant 3,
//     "once approved, the row is immutable" — enforced at the
//     application/repository layer too, this is the database-level
//     defense-in-depth backstop) — triggers have no Prisma-schema-language
//     equivalent, same precedent as `admin.audit_log`'s insert-only
//     trigger and `identity.persons`'s age-gate trigger.
//   - `opportunities.search_vector`, the ADR-0017 generated `tsvector`
//     column, and its GIN index (`idx_opportunities_search`) — per
//     ADR-0017's own Implementation Notes, `GENERATED ALWAYS AS ... STORED`
//     columns are not natively representable in Prisma's schema language,
//     so this column is added via hand-authored migration SQL and modeled
//     here only as `Unsupported("tsvector")` so Prisma is aware of it for
//     introspection without trying to manage its generation logic. Built
//     from `title` (weight A), `category` + `skills_required` (weight B),
//     and `description` (weight C) — the fields this aggregate actually
//     has (the Schema Sketch has no separate `location_name`/
//     `skills_tags_text` denormalized columns the way ADR-0017's own
//     illustrative example does; generated columns may only reference
//     other columns on the same row, so `skills_required` is flattened
//     in-expression via `array_to_string`, not a second denormalized
//     column).
//
//     Same `Unsupported()` round-trip gap as `admin.audit_log.ip_address`
//     (see that model's comment above), but sharper here: confirmed
//     directly that `prisma migrate dev`/`migrate diff` run against this
//     schema proposes `ALTER TABLE volunteering.opportunities ALTER COLUMN
//     search_vector DROP DEFAULT` (misreading the generated-column
//     expression as an ordinary column default) *and* `DROP INDEX
//     volunteering.idx_opportunities_search` (the GIN index has no
//     `@@index` counterpart here, same precedent as every other
//     hand-authored partial/GIN index in this file) every time it's run
//     from this point on. Unlike the `ip_address` case, this proposed diff
//     is NOT safe to accept — applying it would break the generated column
//     and silently drop working search infrastructure. Reproduced and
//     rejected once already (never applied) while building this migration;
//     any future `migrate dev` prompt proposing exactly these two
//     statements against `volunteering.opportunities` should be declined
//     the same way, not applied.

enum VolunteeringOpportunityStatus {
  draft
  published
  closed
  archived

  @@map("opportunity_status")
  @@schema("volunteering")
}

enum VolunteeringLocationType {
  in_person
  remote
  hybrid

  @@map("location_type")
  @@schema("volunteering")
}

enum VolunteeringShiftStatus {
  scheduled
  cancelled
  completed

  @@map("shift_status")
  @@schema("volunteering")
}

enum VolunteeringApplicationStatus {
  pending
  accepted
  waitlisted
  declined
  withdrawn

  @@map("application_status")
  @@schema("volunteering")
}

enum VolunteeringHourEntryStatus {
  submitted
  approved
  rejected

  @@map("hour_entry_status")
  @@schema("volunteering")
}

model Opportunity {
  id                    String                        @id
  chapterId             String?                       @map("chapter_id")
  title                 String
  description           String
  category              String
  skillsRequired        String[]                      @default([]) @map("skills_required")
  locationType          VolunteeringLocationType      @map("location_type")
  minAge                Int                           @default(16) @map("min_age")
  prerequisiteCourseIds String[]                      @default([]) @map("prerequisite_course_ids")
  createdByPersonId     String                        @map("created_by_person_id")
  status                VolunteeringOpportunityStatus @default(draft)
  publishedAt           DateTime?                     @map("published_at") @db.Timestamptz(6)
  closedAt              DateTime?                     @map("closed_at") @db.Timestamptz(6)
  createdAt             DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                      @default(now()) @map("updated_at") @db.Timestamptz(6)
  searchVector          Unsupported("tsvector")?      @map("search_vector")

  shifts      Shift[]
  hourEntries HourEntry[]

  @@index([chapterId], map: "idx_opportunities_chapter")
  @@index([status], map: "idx_opportunities_status")
  @@map("opportunities")
  @@schema("volunteering")
}

model Shift {
  id            String                  @id
  opportunityId String                  @map("opportunity_id")
  startsAt      DateTime                @map("starts_at") @db.Timestamptz(6)
  endsAt        DateTime                @map("ends_at") @db.Timestamptz(6)
  timezone      String
  capacity      Int
  acceptedCount Int                     @default(0) @map("accepted_count")
  status        VolunteeringShiftStatus @default(scheduled)
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)

  opportunity  Opportunity   @relation(fields: [opportunityId], references: [id])
  applications Application[]
  hourEntries  HourEntry[]

  @@index([opportunityId], map: "idx_shifts_opportunity")
  @@index([startsAt], map: "idx_shifts_starts_at")
  @@map("shifts")
  @@schema("volunteering")
}

model Application {
  id                String                        @id
  shiftId           String                        @map("shift_id")
  applicantPersonId String                        @map("applicant_person_id")
  status            VolunteeringApplicationStatus @default(pending)
  appliedAt         DateTime                      @default(now()) @map("applied_at") @db.Timestamptz(6)
  decidedByPersonId String?                       @map("decided_by_person_id")
  decidedAt         DateTime?                     @map("decided_at") @db.Timestamptz(6)
  decisionNote      String?                       @map("decision_note")

  shift Shift @relation(fields: [shiftId], references: [id])

  @@index([shiftId], map: "idx_applications_shift")
  @@index([applicantPersonId], map: "idx_applications_applicant")
  @@map("applications")
  @@schema("volunteering")
}

model HourEntry {
  id               String                      @id
  personId         String                      @map("person_id")
  opportunityId    String                      @map("opportunity_id")
  shiftId          String?                     @map("shift_id")
  startAt          DateTime                    @map("start_at") @db.Timestamptz(6)
  endAt            DateTime                    @map("end_at") @db.Timestamptz(6)
  durationMinutes  Int                         @map("duration_minutes")
  description      String?
  status           VolunteeringHourEntryStatus @default(submitted)
  submittedAt      DateTime                    @default(now()) @map("submitted_at") @db.Timestamptz(6)
  approverPersonId String?                     @map("approver_person_id")
  approvedAt       DateTime?                   @map("approved_at") @db.Timestamptz(6)
  rejectedAt       DateTime?                   @map("rejected_at") @db.Timestamptz(6)
  rejectionReason  String?                     @map("rejection_reason")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id])
  shift       Shift?      @relation(fields: [shiftId], references: [id])

  @@index([personId], map: "idx_hour_entries_person")
  @@index([opportunityId], map: "idx_hour_entries_opportunity")
  @@map("hour_entries")
  @@schema("volunteering")
}

// ---------------------------------------------------------------------------
// Phase 4 — Training & Learning: data model only
// ---------------------------------------------------------------------------
//
// The Course, Enrollment, and Certificate aggregates (with their child
// entities/value objects Module, ModulePrerequisite, Video, Quiz,
// QuizQuestion, QuizChoice, ModuleProgress, QuizAttempt,
// QuizAttemptAnswer) from docs/ddd/training-learning.md, matching that
// doc's own Schema Sketch field-for-field. All nine live in the `training`
// schema and use real foreign keys between each other — the
// no-cross-schema-FK rule (ADR-0001) applies only at bounded-context
// boundaries, not within one. `training.domain_events`
// (`TrainingDomainEvent`, above) already exists from Phase 1; this phase
// only adds the nine aggregate/entity tables. No use cases, no API in this
// migration — the migration this schema drives is data model only.
//
// `created_by_person_id` (Course) and `person_id` (Enrollment,
// Certificate) are intentional soft references (plain columns, no
// relation, no FK) to `identity.persons.id` — cross-schema, so no FK is
// possible or wanted, per the Schema Sketch's own comments and ADR-0001.
//
// Several constructs in the Schema Sketch have no Prisma-schema-language
// equivalent and are hand-authored in the migration SQL instead — same
// precedent as every hand-authored addition already in this file's earlier
// phases:
//   - `chk_quiz_passing_score`, `chk_module_progress_watch_percent`,
//     `chk_quiz_attempt_score_percent`, and
//     `chk_module_prerequisite_no_self_reference` CHECK constraints — the
//     four inline CHECKs the Schema Sketch itself writes (no stable
//     `@@check` attribute in this Prisma version). Quiz invariant 4 ("a
//     Question must have at least one Choice flagged `isCorrect = true`")
//     and every other prose-only invariant in docs/ddd/training-learning.md
//     that spans a row-set rather than a single row (e.g. Enrollment
//     invariant 3, Module invariant 1/2, Certificate invariant 2) has no
//     corresponding DDL in the Schema Sketch either — same precedent as
//     Phase 3's Application/HourEntry status-transition invariants,
//     enforced at the application layer once the use cases are built, not
//     baked into this data-model-only migration.
//   - `uq_enrollment_active_person_course`, the partial unique index
//     enforcing Enrollment invariant 1 ("exactly one **active** Enrollment
//     per (personId, courseId)") — Prisma's schema language has no
//     partial-index syntax.
//   - `course.search_vector`, `module.search_vector`, and
//     `video.search_vector`, the ADR-0017 generated `tsvector` columns and
//     their GIN indexes — per ADR-0017's own Implementation Notes,
//     `GENERATED ALWAYS AS ... STORED` columns are not natively
//     representable in Prisma's schema language, so these columns are
//     added via hand-authored migration SQL and modeled here only as
//     `Unsupported("tsvector")` so Prisma is aware of them for
//     introspection without trying to manage their generation logic.
//     Three separate columns (not one) because, unlike
//     `volunteering.opportunities` (a single denormalized table),
//     training's searchable text is split across three tables — Course
//     owns `title`/`description`, Module owns `title`, Video owns
//     `transcript_text` — and a Postgres generated column can only
//     reference columns on its own row. This is a deliberate refinement
//     of the Schema Sketch's own `idx_video_transcript_fts` (a plain,
//     non-generated functional index on `video` alone): the Phase 4
//     implementation prompt explicitly calls for "the tsvector generated
//     column and GIN index across course/module titles and video
//     transcript text" per ADR-0017, so all three tables get the same
//     `GENERATED ALWAYS AS ... STORED` + GIN treatment already established
//     by `volunteering.opportunities.search_vector`, and the app-layer
//     training search procedure (a later phase) composes across all three
//     — same "federated per-schema search" pattern ADR-0017 describes,
//     refined here to federate per-table since that's where this schema's
//     content actually lives. Named `idx_course_search`/`idx_module_search`/
//     `idx_video_search` to match the `idx_opportunities_search` naming
//     convention already established, rather than the sketch's
//     `idx_video_transcript_fts` name.
//
//     Same `Unsupported()` round-trip gap as
//     `volunteering.opportunities.search_vector` (see that model's comment
//     above): any future `migrate dev`/`migrate diff` prompt proposing to
//     drop these three generated columns or their GIN indexes must be
//     declined, not applied.

enum TrainingCourseStatus {
  draft
  published
  archived

  @@map("course_status")
  @@schema("training")
}

enum TrainingEncodeStatus {
  uploading
  processing
  ready
  error

  @@map("encode_status")
  @@schema("training")
}

enum TrainingCaptionStatus {
  pending
  auto_generated
  human_review
  approved

  @@map("caption_status")
  @@schema("training")
}

enum TrainingEnrollmentStatus {
  active
  completed
  withdrawn

  @@map("enrollment_status")
  @@schema("training")
}

enum TrainingProgressStatus {
  not_started
  in_progress
  completed

  @@map("progress_status")
  @@schema("training")
}

model Course {
  id                        String                   @id
  slug                      String                   @unique
  title                     String
  description               String                   @default("")
  status                    TrainingCourseStatus     @default(draft)
  passingCertificateEnabled Boolean                  @default(true) @map("passing_certificate_enabled")
  createdByPersonId         String                   @map("created_by_person_id")
  publishedAt               DateTime?                @map("published_at") @db.Timestamptz(6)
  createdAt                 DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  searchVector              Unsupported("tsvector")? @map("search_vector")

  modules      Module[]
  enrollments  Enrollment[]
  certificates Certificate[]

  @@index([status], map: "idx_course_status")
  @@map("course")
  @@schema("training")
}

model Module {
  id           String                   @id
  courseId     String                   @map("course_id")
  title        String
  sequence     Int
  isRequired   Boolean                  @default(true) @map("is_required")
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  searchVector Unsupported("tsvector")? @map("search_vector")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  video  Video?
  quiz   Quiz?

  moduleProgress ModuleProgress[]

  // Prerequisite DAG (Module.md's "Prerequisite" term / invariant 2):
  // `dependsOn` = the prerequisite edges this module requires; `requiredBy`
  // = the edges pointing at this module from dependents.
  dependsOn  ModulePrerequisite[] @relation("ModulePrerequisiteModule")
  requiredBy ModulePrerequisite[] @relation("ModulePrerequisitePrerequisiteModule")

  @@unique([courseId, sequence])
  @@index([courseId], map: "idx_module_course")
  @@map("module")
  @@schema("training")
}

// Value object (docs/ddd/training-learning.md "ModulePrerequisite"):
// expresses a dependency DAG within a course; deliberately not merely
// `Module.sequence` order (see that field's own doc comment). Composite
// primary key, no surrogate `id`, matching the Schema Sketch exactly.
model ModulePrerequisite {
  moduleId             String @map("module_id")
  prerequisiteModuleId String @map("prerequisite_module_id")

  module             Module @relation("ModulePrerequisiteModule", fields: [moduleId], references: [id], onDelete: Cascade)
  prerequisiteModule Module @relation("ModulePrerequisitePrerequisiteModule", fields: [prerequisiteModuleId], references: [id], onDelete: Cascade)

  @@id([moduleId, prerequisiteModuleId])
  @@map("module_prerequisite")
  @@schema("training")
}

// Entity, owned by exactly one Module, modeled as its own entity because it
// has an independent lifecycle driven by an external system — Cloudflare
// Stream (ADR-0010).
model Video {
  id                 String                   @id
  moduleId           String                   @unique @map("module_id")
  cloudflareStreamId String                   @unique @map("cloudflare_stream_id")
  durationSeconds    Int?                     @map("duration_seconds")
  encodeStatus       TrainingEncodeStatus     @default(uploading) @map("encode_status")
  captionStatus      TrainingCaptionStatus    @default(pending) @map("caption_status")
  transcriptText     String?                  @map("transcript_text")
  thumbnailUrl       String?                  @map("thumbnail_url")
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  searchVector       Unsupported("tsvector")? @map("search_vector")

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("video")
  @@schema("training")
}

model Quiz {
  id                  String   @id
  moduleId            String   @unique @map("module_id")
  passingScorePercent Int      @map("passing_score_percent") @db.SmallInt
  maxAttempts         Int?     @map("max_attempts") @db.SmallInt
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  module    Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@map("quiz")
  @@schema("training")
}

// Value object, persisted as its own row (docs/ddd/training-learning.md's
// own reasoning: attempts must reference exact question identity for
// scoring/audit) but conceptually part of Quiz and never addressed outside
// it.
model QuizQuestion {
  id       String @id
  quizId   String @map("quiz_id")
  prompt   String
  sequence Int

  quiz    Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  choices QuizChoice[]
  answers QuizAttemptAnswer[]

  @@unique([quizId, sequence])
  @@map("quiz_question")
  @@schema("training")
}

// Value object, same reasoning as QuizQuestion.
model QuizChoice {
  id         String  @id
  questionId String  @map("question_id")
  label      String
  isCorrect  Boolean @default(false) @map("is_correct")
  sequence   Int

  question QuizQuestion        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  QuizAttemptAnswer[]

  @@unique([questionId, sequence])
  @@map("quiz_choice")
  @@schema("training")
}

model Enrollment {
  id          String                   @id
  personId    String                   @map("person_id")
  courseId    String                   @map("course_id")
  status      TrainingEnrollmentStatus @default(active)
  enrolledAt  DateTime                 @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  completedAt DateTime?                @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)

  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  moduleProgress ModuleProgress[]
  quizAttempts   QuizAttempt[]
  certificates   Certificate[]

  @@index([personId], map: "idx_enrollment_person")
  @@map("enrollment")
  @@schema("training")
}

model ModuleProgress {
  id                    String                 @id
  enrollmentId          String                 @map("enrollment_id")
  moduleId              String                 @map("module_id")
  status                TrainingProgressStatus @default(not_started)
  resumePositionSeconds Int                    @default(0) @map("resume_position_seconds")
  watchProgressPercent  Int                    @default(0) @map("watch_progress_percent") @db.SmallInt
  completedAt           DateTime?              @map("completed_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  module     Module     @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, moduleId])
  @@index([enrollmentId], map: "idx_module_progress_enrollment")
  @@map("module_progress")
  @@schema("training")
}

model QuizAttempt {
  id           String   @id
  enrollmentId String   @map("enrollment_id")
  quizId       String   @map("quiz_id")
  scorePercent Int      @map("score_percent") @db.SmallInt
  passed       Boolean
  submittedAt  DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  enrollment Enrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  quiz       Quiz                @relation(fields: [quizId], references: [id], onDelete: Restrict)
  answers    QuizAttemptAnswer[]

  @@index([enrollmentId, quizId], map: "idx_quiz_attempt_enrollment_quiz")
  @@map("quiz_attempt")
  @@schema("training")
}

// Value object row recording the Choice selected per Question for one
// QuizAttempt (audit/analytics). Composite primary key, no surrogate `id`,
// matching the Schema Sketch exactly.
model QuizAttemptAnswer {
  attemptId  String  @map("attempt_id")
  questionId String  @map("question_id")
  choiceId   String  @map("choice_id")
  isCorrect  Boolean @map("is_correct")

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  choice   QuizChoice   @relation(fields: [choiceId], references: [id], onDelete: Restrict)

  @@id([attemptId, questionId])
  @@map("quiz_attempt_answer")
  @@schema("training")
}

model Certificate {
  id                String    @id
  personId          String    @map("person_id")
  courseId          String    @map("course_id")
  enrollmentId      String    @map("enrollment_id")
  certificateNumber String    @unique @map("certificate_number")
  pdfFileKey        String?   @map("pdf_file_key")
  templateVersion   String    @map("template_version")
  issuedAt          DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz(6)

  course     Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@unique([personId, courseId, enrollmentId])
  @@index([personId], map: "idx_certificate_person")
  @@map("certificate")
  @@schema("training")
}

model AuditLog {
  id           String               @id
  occurredAt   DateTime             @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorId      String?              @map("actor_id")
  actorType    String               @map("actor_type")
  action       String
  resourceType String               @map("resource_type")
  resourceId   String               @map("resource_id")
  scopeType    String?              @map("scope_type")
  scopeId      String?              @map("scope_id")
  beforeState  Json?                @map("before_state")
  afterState   Json?                @map("after_state")
  metadata     Json                 @default("{}")
  ipAddress    Unsupported("inet")? @map("ip_address")
  requestId    String?              @map("request_id")

  @@index([actorId, occurredAt(sort: Desc)], map: "audit_log_actor_idx")
  @@index([resourceType, resourceId, occurredAt(sort: Desc)], map: "audit_log_resource_idx")
  @@index([action, occurredAt(sort: Desc)], map: "audit_log_action_idx")
  @@map("audit_log")
  @@schema("admin")
}

// ---------------------------------------------------------------------------
// Phase 5 — Gamification: schema only (points ledger, badges, streaks,
// scoped leaderboard projection)
// ---------------------------------------------------------------------------
//
// The PointsLedgerEntry, PointsBalance, Badge, BadgeAward, Streak, and
// LeaderboardSnapshot shapes from docs/ddd/gamification.md, matching that
// doc's own Schema Sketch field-for-field. `gamification.domain_events`
// (`GamificationDomainEvent`, above) already exists from Phase 1; this
// phase adds the aggregate/projection tables plus the inbound-event
// idempotency ledger. No use cases, no event consumers, no API in this
// migration — those are a later stage; this migration is data model only.
//
// `person_id` on every table below (`PointsLedgerEntry`, `PointsBalance`,
// `BadgeAward`, `Streak`, `LeaderboardSnapshot`) is an intentional soft
// reference (plain column, no relation, no FK) to `identity.persons.id` —
// cross-schema, so no FK is possible or wanted, per the Schema Sketch's own
// comments and ADR-0001. `BadgeAward.badgeId` IS a real FK (`ON DELETE
// RESTRICT`) because `Badge` and `BadgeAward` are both owned by this same
// `gamification` schema — the no-cross-schema-FK rule applies only at
// bounded-context boundaries, not within one.
//
// `LeaderboardSnapshot.scopeId` is a soft reference to `community.team.id`
// or `community.challenge.id` (not yet built) — same reasoning, and see
// the Leaderboard invariant note below. `scope_type` is backed by a
// two-value Postgres enum (`gamification.leaderboard_scope_type`) whose
// only members are `team` and `challenge` — per docs/ddd/gamification.md's
// explicit, load-bearing invariant, "'global' intentionally does not
// exist" is not a comment on unused DDL, it is the enforcement mechanism:
// no migration, application code path, or future config toggle can ever
// produce an unscoped/platform-wide leaderboard row, because the type
// itself has no value that could mean "global." This is the schema-level
// half of the product constraint (leaderboards must never be global for
// this high-intrinsic-motivation population); the API-layer half (rejecting
// any request that omits a scope) is a later stage's job.
//
// Several constructs in the Schema Sketch have no Prisma-schema-language
// equivalent and are hand-authored in the migration SQL instead — same
// precedent as every hand-authored addition already in this file's earlier
// phases:
//   - `points_ledger_no_update` / `points_ledger_no_delete`, the two
//     `CREATE RULE ... DO INSTEAD NOTHING` statements the Schema Sketch
//     itself specifies verbatim for `points_ledger_entry` (PointsLedgerEntry
//     invariant 1: "no application code path performs UPDATE or DELETE on
//     this table; enforced defensively with a Postgres rule/trigger").
//     Deliberately a RULE that silently no-ops, not a trigger that raises
//     (contrast `admin.audit_log`'s insert-only trigger, which does raise) —
//     matching the Schema Sketch's own literal SQL rather than reusing the
//     audit-log pattern, since the DDD doc specifies this exact mechanism
//     for this table. Postgres RULEs have no Prisma-schema-language
//     equivalent at all (unlike triggers, which at least have precedent
//     elsewhere in this file as hand-authored SQL), so this is pure
//     hand-authored DDL.
//
// `gamification.processed_events` (`GamificationProcessedEvent` below) is
// deliberately keyed `(source_event_id, event_type)` — no `consumer`
// column — matching docs/ddd/gamification.md's Schema Sketch and its
// Integration & Anti-Corruption Notes worked example exactly
// ("INSERT INTO gamification.processed_events (source_event_id,
// event_type) VALUES (...)"). This is a deliberate, intentional divergence
// from `packages/outbox`'s generic `processed-events.template.sql`
// (`(consumer, event_id)`, built for a table that may be drained by
// several independent consumers): `gamification.ConsumeInboundEvent` is
// this context's single logical entry point for every subscribed event
// type across both source schemas (`volunteering.domain_events` and
// `training.domain_events`), not several independent consumers draining
// the same table, so a `consumer` column would add a dimension this
// context doesn't have — and `event_type` already disambiguates across
// source contexts because `HoursApproved`, `ModuleCompleted`, and
// `CourseCompleted` are globally distinct event-type strings. A later
// stage building the actual event consumers may therefore need to write
// its own idempotency-check helper (mirroring `packages/outbox`'s
// `handleIdempotently` shape from ADR-0009's Implementation Notes) rather
// than calling `drainOutbox()` unmodified, since that helper's `INSERT ...
// (consumer, event_id) ... ON CONFLICT (consumer, event_id)` is hard-coded
// to the other shape — confirmed by reading `packages/outbox/src/drainOutbox.ts`
// directly, not assumed.

enum GamificationStreakStatus {
  active
  frozen
  broken

  @@map("streak_status")
  @@schema("gamification")
}

// 'global' intentionally has no representable value — see the header
// comment above and docs/ddd/gamification.md's Leaderboard invariant.
enum GamificationLeaderboardScopeType {
  team
  challenge

  @@map("leaderboard_scope_type")
  @@schema("gamification")
}

// Append-only aggregate root (docs/ddd/gamification.md "PointsLedgerEntry"):
// every point change, award or correction, is a new row — there is no
// UPDATE path anywhere in the application. `points` is signed; a negative
// row is a compensating correction, never a mutation of a prior row.
// Invariant 2 (exactly one entry per `(sourceEventType, sourceEventId)`) is
// the concrete mechanism behind idempotent event consumption at the
// `PointsLedgerEntry` level — a second, independent backstop below
// `gamification.processed_events`. Invariant 1 (immutability) is enforced
// defensively at the database level too, via the two hand-authored
// `CREATE RULE` statements in this migration's SQL — see the header
// comment above.
model PointsLedgerEntry {
  id              String   @id
  personId        String   @map("person_id")
  points          Int
  sourceEventType String   @map("source_event_type")
  sourceEventId   String   @map("source_event_id")
  reason          String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([sourceEventType, sourceEventId])
  @@index([personId, createdAt(sort: Desc)], map: "idx_points_ledger_person")
  @@map("points_ledger_entry")
  @@schema("gamification")
}

// Materialized projection (docs/ddd/gamification.md "PointsBalance"), NOT
// an aggregate root and NOT a second source of truth — always re-derivable
// as `SUM(points) GROUP BY person_id` over `PointsLedgerEntry`. Refreshed
// incrementally in the same transaction as each new ledger write; also
// fully rebuildable from the ledger by a maintenance job. Unlike the
// ledger, ordinary UPDATE is expected and correct here — this table is a
// cache, not the append-only fact log.
model PointsBalance {
  personId          String   @id @map("person_id")
  totalPoints       BigInt   @default(0) @map("total_points")
  lastLedgerEntryId String?  @map("last_ledger_entry_id")
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("points_balance")
  @@schema("gamification")
}

// Aggregate root, achievement definition (docs/ddd/gamification.md
// "Badge"). `criteria` is structured JSON interpreted by the
// `EvaluateBadgeCriteria` application service, never by the database.
// `active = false` retires a badge from being newly awardable but — per
// this context's second hard rule (badges are permanent, shareable
// artifacts) — existing `BadgeAward` rows referencing it are never removed
// or hidden; a badge already earned stays visible on a person's profile
// even after its own definition is later deactivated.
model Badge {
  id          String   @id
  slug        String   @unique
  name        String
  description String   @default("")
  iconUrl     String?  @map("icon_url")
  criteria    Json
  isPublic    Boolean  @default(true) @map("is_public")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  badgeAwards BadgeAward[]

  @@map("badge")
  @@schema("gamification")
}

// Aggregate root (docs/ddd/gamification.md "BadgeAward"): the fact one
// specific Person earned one specific Badge, once. The unique constraint
// below is the whole idempotency mechanism for `AwardBadge`
// (`ON CONFLICT (person_id, badge_id) DO NOTHING` at the application
// layer) — re-processing the same qualifying event a second time is a
// no-op, not a duplicate award. `badgeId` is a real, same-schema FK
// (`ON DELETE RESTRICT` — a Badge definition can never be deleted out from
// under an existing award; retire it via `active = false` instead).
model BadgeAward {
  id            String   @id
  personId      String   @map("person_id")
  badgeId       String   @map("badge_id")
  sourceEventId String?  @map("source_event_id")
  awardedAt     DateTime @default(now()) @map("awarded_at") @db.Timestamptz(6)

  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Restrict)

  @@unique([personId, badgeId])
  @@index([personId], map: "idx_badge_award_person")
  @@map("badge_award")
  @@schema("gamification")
}

// Aggregate root (docs/ddd/gamification.md "Streak"): a per-person,
// per-activity-type running count of consecutive active periods, with a
// forgiveness/grace mechanic (`freezesAvailable`/`freezesUsedTotal`) —
// deliberately not a pure punish-on-any-miss streak, per the research
// finding cited in that doc. `activityType` is plain text with an
// app-level allow-list (e.g. `training_cadence`, `shift_cadence`), not a
// Postgres enum, since new streak types are expected without a schema
// migration. `lastActivityDate` is a DATE, not a timestamp — cadence is
// period-granular, matching the Schema Sketch exactly.
model Streak {
  id               String                   @id
  personId         String                   @map("person_id")
  activityType     String                   @map("activity_type")
  currentLength    Int                      @default(0) @map("current_length")
  longestLength    Int                      @default(0) @map("longest_length")
  lastActivityDate DateTime?                @map("last_activity_date") @db.Date
  freezesAvailable Int                      @default(2) @map("freezes_available") @db.SmallInt
  freezesUsedTotal Int                      @default(0) @map("freezes_used_total")
  status           GamificationStreakStatus @default(active)
  updatedAt        DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([personId, activityType])
  @@map("streak")
  @@schema("gamification")
}

// Read-model / projection (docs/ddd/gamification.md "Leaderboard"), NOT a
// transactionally-written aggregate — rebuilt from `PointsLedgerEntry` rows
// filtered by `LeaderboardScope` and time window by `RebuildLeaderboardSnapshot`,
// never from this table itself (a cache of a cache would be a bug, per that
// use case's own doc comment). `scopeType` + `scopeId` together are the
// `LeaderboardScope` value object, and `scopeType`'s enum has no "global"
// member — see the header comment above for why that is a hard invariant,
// not a convention.
model LeaderboardSnapshot {
  id          String                            @id
  scopeType   GamificationLeaderboardScopeType  @map("scope_type")
  scopeId     String                            @map("scope_id")
  personId    String                            @map("person_id")
  rank        Int
  points      BigInt
  periodStart DateTime                          @map("period_start") @db.Timestamptz(6)
  periodEnd   DateTime                          @map("period_end") @db.Timestamptz(6)
  computedAt  DateTime                          @default(now()) @map("computed_at") @db.Timestamptz(6)

  @@unique([scopeType, scopeId, personId, periodStart])
  @@index([scopeType, scopeId, periodStart, rank], map: "idx_leaderboard_scope_rank")
  @@map("leaderboard_snapshot")
  @@schema("gamification")
}

// Idempotent inbound-event consumption ledger (ADR-0009; docs/ddd/gamification.md
// "Processed Event" / Integration & Anti-Corruption Notes). Keyed by
// `(sourceEventId, eventType)`, NOT `(consumer, event_id)` — see the header
// comment above for why this deliberately diverges from
// `packages/outbox`'s generic template. A later stage's
// `ConsumeInboundEvent` handler attempts an insert here inside the same
// transaction as any resulting `PointsLedgerEntry`/`BadgeAward`/`Streak`
// writes; a primary-key conflict means the event was already processed and
// the transaction no-ops.
model GamificationProcessedEvent {
  sourceEventId String   @map("source_event_id")
  eventType     String   @map("event_type")
  processedAt   DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([sourceEventId, eventType])
  @@map("processed_events")
  @@schema("gamification")
}

// ---------------------------------------------------------------------------
// Phase 6 — Community & Social: schema only (activity feed, kudos, teams,
// mentorship, and the inbound-event idempotency ledger)
// ---------------------------------------------------------------------------
//
// The Post, FeedEntry, Kudos, Team, TeamMembership, Mentorship, and
// ProcessedEvent shapes from docs/ddd/community-social.md, matching that
// doc's own Schema Sketch field-for-field. `community.domain_events`
// (`CommunityDomainEvent`, above) already exists from Phase 1; this phase
// adds the aggregate/read-model tables plus the inbound-event idempotency
// ledger. No use cases, no event consumers, no API in this migration — those
// are a later stage; this migration is data model only.
//
// `author_id`, `author_chapter_id`, `scope_id` (on both Post and FeedEntry),
// `hidden_by_moderation_action_id`, `subject_person_id`,
// `from_person_id`/`to_person_id`, `chapter_id`, `created_by_person_id`,
// `person_id` (TeamMembership), and `mentor_person_id`/`mentee_person_id`
// are all intentional soft references (plain columns, no relation, no FK) to
// `identity.persons.id` / `identity.chapters.id` / `moderation.moderation_action.id`
// — cross-schema, so no FK is possible or wanted, per the Schema Sketch's own
// comments and ADR-0001. `TeamMembership.teamId` IS a real, same-schema FK
// (`ON DELETE CASCADE`, per the Schema Sketch) because `Team` and
// `TeamMembership` are both owned by this same `community` schema — the
// no-cross-schema-FK rule applies only at bounded-context boundaries, not
// within one.
//
// `community.processed_events` (`CommunityProcessedEvent` below) is keyed by
// a single `id` column (the origin `domain_events.id`, a ULID) — matching
// docs/ddd/community-social.md's Schema Sketch exactly, and deliberately
// NOT `packages/outbox`'s generic `(consumer, event_id)` template
// (`processed-events.template.sql`): this context has exactly one logical
// consumer per source event (one handler per event type — `HandleBadgeAwarded`,
// `HandleHoursApproved`, `HandleCourseCompleted`, `HandleStreakExtended`,
// `HandlePersonAnonymized`), not several independent consumers draining the
// same table, so a `consumer` column would add a dimension this context
// doesn't have — same reasoning already recorded against
// `gamification.processed_events` above, though that one additionally keys
// on `event_type` (composite PK) where this one is a single-column PK,
// per the Schema Sketch's literal DDL. A later stage building the actual
// event handlers therefore writes its own idempotency-check helper
// (`INSERT INTO community.processed_events (id, ...) ON CONFLICT (id) DO
// NOTHING`) rather than calling `packages/outbox`'s `drainOutbox()`
// unmodified.
//
// Several constructs in the Schema Sketch have no Prisma-schema-language
// equivalent and are hand-authored in the migration SQL instead — same
// precedent as every hand-authored addition already in this file's earlier
// phases:
//   - `chk_post_scope`, `chk_post_body_length`, `chk_post_attachments_max`,
//     `chk_feed_entry_scope`, `chk_kudos_no_self`,
//     `chk_kudos_achievement_ref_pair`, and `chk_mentorship_no_self` CHECK
//     constraints (no stable `@@check` attribute in this Prisma version).
//   - `idx_post_scope_created` and the kudos/mentorship indexes ARE plain
//     (non-partial) indexes and so DO have `@@index` counterparts below;
//     only the *partial* indexes/uniques are hand-authored:
//     `idx_feed_entry_scope_created` (the chapter-scoped, reverse-
//     chronological feed hot path — WHERE hidden_at IS NULL),
//     `uq_feed_entry_native_source` / `uq_feed_entry_source_event` (the two
//     halves of FeedEntry invariant 3's "exactly one row per native source /
//     per projected source event" rule — mutually exclusive partial unique
//     indexes, since exactly one of `source_event_id IS NULL` holds for any
//     given row), `uq_team_chapter_name_active` (Team invariant 1),
//     `uq_team_membership_open` (TeamMembership invariant 2) and
//     `idx_team_membership_person`, and `uq_mentorship_open_mentee`
//     (Mentorship invariant 2) — Prisma's schema language has no
//     partial-index syntax.
//   - `post.search_vector`, the ADR-0017 generated `tsvector` column, and
//     its GIN index (`idx_post_search`) — per ADR-0017's own Implementation
//     Notes, `GENERATED ALWAYS AS ... STORED` columns are not natively
//     representable in Prisma's schema language, so this column is added via
//     hand-authored migration SQL and modeled here only as
//     `Unsupported("tsvector")` so Prisma is aware of it for introspection
//     without trying to manage its generation logic. Built from `body` alone
//     (single-field pattern, matching ADR-0017's own `community.posts`
//     worked example exactly) — same `Unsupported()` round-trip gap as
//     `volunteering.opportunities.search_vector` (see that model's comment
//     above): any future `migrate dev` prompt proposing to drop
//     `search_vector`'s default or drop `idx_post_search` against
//     `community.post` should be declined, not applied.

enum CommunityScopeType {
  org
  chapter

  @@map("scope_type")
  @@schema("community")
}

enum CommunityPostStatus {
  published
  hidden
  deleted

  @@map("post_status")
  @@schema("community")
}

enum CommunityFeedEntryKind {
  post
  kudos_given
  team_joined
  mentorship_started
  mentorship_completed
  badge_awarded
  hours_approved
  course_completed
  streak_extended

  @@map("feed_entry_kind")
  @@schema("community")
}

enum CommunityTeamStatus {
  active
  archived

  @@map("team_status")
  @@schema("community")
}

enum CommunityTeamRole {
  lead
  member

  @@map("team_role")
  @@schema("community")
}

enum CommunityMentorshipStatus {
  requested
  active
  completed
  declined
  cancelled

  @@map("mentorship_status")
  @@schema("community")
}

// Aggregate root (docs/ddd/community-social.md "Post"). `authorDisplayName`
// is a snapshot, refreshed to 'Deleted User' by a later stage's
// `HandlePersonAnonymized` handler (not built in this phase).
// `authorChapterId` is snapshotted at creation — the chapter the author
// belonged to *when they posted* — so the scope invariant (Post invariant 1)
// can be evaluated without a live cross-schema read on every write.
// `attachments` is a JSONB array of the Attachment value object
// (`{r2ObjectKey, contentType, sizeBytes, altText}`), 0-4 per Post, never
// binary data. `searchVector` (ADR-0017) is a real `GENERATED ALWAYS AS ...
// STORED` column added by hand-authored migration SQL — see the header
// comment above.
model Post {
  id                          String               @id
  authorId                    String               @map("author_id")
  authorDisplayName           String               @map("author_display_name")
  authorChapterId             String?              @map("author_chapter_id")
  body                        String
  scopeType                   CommunityScopeType   @map("scope_type")
  scopeId                     String?              @map("scope_id")
  attachments                 Json                 @default("[]")
  status                      CommunityPostStatus  @default(published)
  hiddenByModerationActionId  String?              @map("hidden_by_moderation_action_id")
  createdAt                   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  searchVector                Unsupported("tsvector")? @map("search_vector")

  @@index([scopeType, scopeId, id(sort: Desc)], map: "idx_post_scope_created")
  @@index([authorId], map: "idx_post_author")
  @@map("post")
  @@schema("community")
}

// Denormalized read-model projection (docs/ddd/community-social.md
// "FeedEntry"), NOT an aggregate root and NOT a second source of truth for
// native `kind = 'post'` rows — those are a thin pointer (`sourceId =
// post.id`) resolved live via an in-schema join against `Post` at read
// time (FeedEntry invariant 2), so a Post edit/hide propagates without
// re-projecting. Every other `kind` is an immutable snapshot of a consumed
// external event (FeedEntry invariant 1) and is never edited after
// creation, only hidden (`hiddenAt`/`hiddenByModerationActionId`).
// `sourceEventId` is NULL for native kinds and drives idempotent projection
// for consumed kinds (FeedEntry invariant 3) — see the two partial unique
// indexes hand-authored in the migration SQL.
model FeedEntry {
  id                          String                  @id
  kind                        CommunityFeedEntryKind
  scopeType                   CommunityScopeType      @map("scope_type")
  scopeId                     String?                 @map("scope_id")
  subjectPersonId             String                  @map("subject_person_id")
  subjectDisplayName          String                  @map("subject_display_name")
  sourceType                  String                  @map("source_type")
  sourceId                    String                  @map("source_id")
  sourceEventId               String?                 @map("source_event_id")
  summary                     String
  payload                     Json                    @default("{}")
  hiddenAt                    DateTime?               @map("hidden_at") @db.Timestamptz(6)
  hiddenByModerationActionId  String?                 @map("hidden_by_moderation_action_id")
  createdAt                   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("feed_entry")
  @@schema("community")
}

// Entity (docs/ddd/community-social.md "Kudos"), not independently
// aggregated beyond itself. `achievementRefType`/`achievementRefId` are an
// optional, all-or-nothing polymorphic pointer (Kudos invariant 2) — stored
// by type+ID only, never joined.
model Kudos {
  id                  String    @id
  fromPersonId        String    @map("from_person_id")
  toPersonId          String    @map("to_person_id")
  note                String?
  achievementRefType  String?   @map("achievement_ref_type")
  achievementRefId    String?   @map("achievement_ref_id")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([toPersonId, id(sort: Desc)], map: "idx_kudos_to_person")
  @@index([fromPersonId, id(sort: Desc)], map: "idx_kudos_from_person")
  @@map("kudos")
  @@schema("community")
}

// Aggregate root (docs/ddd/community-social.md "Team"): a named,
// chapter-scoped guild — always chapter-scoped, never org-wide. Owns child
// entity `TeamMembership` (below) via a real, same-schema FK.
model Team {
  id                  String                @id
  chapterId           String                @map("chapter_id")
  name                String
  description         String                @default("")
  createdByPersonId   String                @map("created_by_person_id")
  status              CommunityTeamStatus   @default(active)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)

  memberships TeamMembership[]

  @@map("team")
  @@schema("community")
}

// Child entity of `Team` (docs/ddd/community-social.md "TeamMembership"): a
// membership row is never deleted, only closed (`leftAt`), to preserve
// history — re-joining after leaving creates a new row (TeamMembership
// invariant 2, enforced by the partial unique index hand-authored in the
// migration SQL).
model TeamMembership {
  id         String              @id
  teamId     String              @map("team_id")
  personId   String              @map("person_id")
  role       CommunityTeamRole   @default(member)
  joinedAt   DateTime            @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt     DateTime?           @map("left_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("team_membership")
  @@schema("community")
}

// Aggregate root (docs/ddd/community-social.md "Mentorship"): a structured
// mentor/mentee pairing moving through an explicit request -> active ->
// completed lifecycle. Mentorship invariant 2 (at most one open
// `requested`/`active` pairing per mentee) is enforced by the partial
// unique index hand-authored in the migration SQL; no equivalent constraint
// applies to `mentorPersonId` (a mentor may have several concurrent
// mentees).
model Mentorship {
  id                String                      @id
  mentorPersonId    String                      @map("mentor_person_id")
  menteePersonId    String                      @map("mentee_person_id")
  status            CommunityMentorshipStatus   @default(requested)
  note              String?
  requestedAt       DateTime                    @default(now()) @map("requested_at") @db.Timestamptz(6)
  startedAt         DateTime?                   @map("started_at") @db.Timestamptz(6)
  endedAt           DateTime?                   @map("ended_at") @db.Timestamptz(6)

  @@index([mentorPersonId, status], map: "idx_mentorship_mentor")
  @@map("mentorship")
  @@schema("community")
}

// Idempotent inbound-event consumption ledger (ADR-0009;
// docs/ddd/community-social.md "Processed Event" / Integration &
// Anti-Corruption Notes). Keyed by a single `id` column (the origin
// `domain_events.id`, a ULID) — see the header comment above for why this
// deliberately diverges from `packages/outbox`'s generic
// `(consumer, event_id)` template. A later stage's per-event-type handler
// (`HandleBadgeAwarded`, `HandleHoursApproved`, `HandleCourseCompleted`,
// `HandleStreakExtended`) attempts an insert here inside the same
// transaction as any resulting `FeedEntry` write; a primary-key conflict
// means the event was already processed and the transaction no-ops — the
// second line of defense behind the `feed_entry` unique indexes themselves.
model CommunityProcessedEvent {
  id             String    @id
  sourceContext  String    @map("source_context")
  eventType      String    @map("event_type")
  processedAt    DateTime  @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@map("processed_events")
  @@schema("community")
}

// ---------------------------------------------------------------------------
// Phase 7 — Moderation & Trust & Safety: schema only (report intake,
// graduated enforcement ladder)
// ---------------------------------------------------------------------------
//
// The Report and ModerationAction aggregates from
// docs/ddd/moderation-trust-safety.md, matching that doc's own Schema
// Sketch field-for-field. `moderation.domain_events`
// (`ModerationDomainEvent`, above) already exists from Phase 1; this phase
// adds the two aggregate tables. No use cases, no event consumers, no API
// in this migration — those are a later stage; this migration is data
// model only.
//
// CRITICAL, already-resolved constraint (ADR-0014 §4, "There is one audit
// log, not two"): this schema does NOT get its own `audit_log` table.
// Every privileged mutation in this context (a later stage's job) writes
// through Phase 1's shared `packages/audit` `recordAuditEvent()` into the
// single `admin.audit_log`, exactly like every other bounded context —
// there is no `moderation.audit_log` model anywhere below, and none should
// ever be added. `grep -i audit_log` against this migration's own SQL
// output turns up nothing but this comment.
//
// `reporter_person_id`, `assigned_moderator_id` (Report), and
// `target_person_id`/`moderator_person_id`/`revoked_by_person_id`
// (ModerationAction) are intentional soft references (plain columns, no
// relation, no FK) to `identity.persons.id` — cross-schema, so no FK is
// possible or wanted, per the Schema Sketch's own comments and ADR-0001.
// `scope_id` on both tables is likewise a soft reference to
// `identity.chapters.id` (NULL iff `scope_type = 'org'`). `reported_entity_type`
// + `reported_entity_id` (Report) is the polymorphic, never-joined
// `{type, id}` pointer described in the doc's "Reported Entity" term —
// deliberately untyped/unconstrained at the DB level; the closed set of
// valid `reportedEntityType` values is enforced at the application layer
// (Zod, per the API Contract Sketch), not a Postgres enum, so a future
// bounded context can become reportable without a migration here.
//
// `Report.resolutionActionId` and `ModerationAction.relatedReportId` ARE
// real, same-schema FKs (the no-cross-schema-FK rule applies only at
// bounded-context boundaries, not within one) — and deliberately circular:
// a Report may resolve to a ModerationAction, and a ModerationAction may
// have been prompted by a Report. The Schema Sketch calls this out
// explicitly ("Deferred FK, added after both tables exist") since one
// direction can't be a same-statement `REFERENCES` when both tables are
// being created together; `prisma migrate dev`'s diff engine resolves this
// itself by ordering `CREATE TABLE` before the second table's
// `ADD CONSTRAINT`, same outcome as the sketch's own hand-ordered SQL, no
// hand-editing required for this part. Both are `ON DELETE SET NULL` (a
// resolved Report or a related-to ModerationAction is never cascaded away
// by the other side's deletion — moderation rows are never deleted in this
// system in practice, but the constraint still matches the sketch exactly).
//
// Several constructs in the Schema Sketch have no Prisma-schema-language
// equivalent and are hand-authored in the migration SQL instead — same
// precedent as every hand-authored addition already in this file's earlier
// phases:
//   - `chk_report_scope`, `chk_report_evidence_max`, `chk_report_no_self`,
//     `chk_moderation_action_scope`, `chk_moderation_action_duration`
//     (Invariant 1: `warn`/`ban` never time-boxed), and
//     `chk_moderation_action_ban_org` (Invariant 3: a `ban` is always
//     org-scoped) CHECK constraints — the exact six inline CHECKs the
//     Schema Sketch itself writes (no stable `@@check` attribute in this
//     Prisma version).
//   - `idx_moderation_action_expiry`, the partial index on `ends_at WHERE
//     status = 'active' AND ends_at IS NOT NULL` backing the hourly
//     `ExpireModerationActions` sweep's hot path — Prisma's schema language
//     has no partial-index syntax. `idx_report_queue`, `idx_report_entity`,
//     `idx_report_assigned`, `idx_moderation_action_target`, and
//     `idx_moderation_action_scope` are all plain (non-partial) indexes and
//     so DO have `@@index` counterparts below.

enum ModerationReportStatus {
  open
  reviewing
  resolved
  dismissed

  @@map("report_status")
  @@schema("moderation")
}

enum ModerationScopeType {
  org
  chapter

  @@map("scope_type")
  @@schema("moderation")
}

enum ModerationActionType {
  warn
  mute
  suspend
  ban

  @@map("action_type")
  @@schema("moderation")
}

enum ModerationActionStatus {
  active
  expired
  revoked

  @@map("action_status")
  @@schema("moderation")
}

// Aggregate root (docs/ddd/moderation-trust-safety.md "Report"). The
// polymorphic `{reportedEntityType, reportedEntityId}` pointer plus
// `reportedContentSnapshot` (invariant 2: captured once at file-time, never
// re-synced — the evidentiary guarantee this whole aggregate exists for)
// are the anti-corruption boundary this context uses instead of ever
// joining into another schema's tables; see the header comment above.
// `scopeType`/`scopeId` are copied from the reported entity's own scope at
// file-time (not a live read) so the report queue can be filtered without a
// cross-schema join. `evidenceAttachments` is a JSONB array of the
// EvidenceAttachment value object (`{r2ObjectKey, contentType, sizeBytes}`),
// 0-6 per Report, never binary data — same shape convention as
// `community.post.attachments`.
model Report {
  id                       String                 @id
  reporterPersonId         String                 @map("reporter_person_id")
  reportedEntityType       String                 @map("reported_entity_type")
  reportedEntityId         String                 @map("reported_entity_id")
  reportedContentSnapshot  Json                   @default("{}") @map("reported_content_snapshot")
  reason                   String
  reasonDetail             String?                @map("reason_detail")
  evidenceAttachments      Json                   @default("[]") @map("evidence_attachments")
  status                   ModerationReportStatus @default(open)
  scopeType                ModerationScopeType    @map("scope_type")
  scopeId                  String?                @map("scope_id")
  assignedModeratorId      String?                @map("assigned_moderator_id")
  resolutionNotes          String?                @map("resolution_notes")
  resolutionActionId       String?                @map("resolution_action_id")
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  resolvedAt               DateTime?              @map("resolved_at") @db.Timestamptz(6)

  resolutionAction ModerationAction?  @relation("ReportResolutionAction", fields: [resolutionActionId], references: [id], onDelete: SetNull)
  relatedActions   ModerationAction[] @relation("ModerationActionRelatedReport")

  @@index([status, scopeType, scopeId, id(sort: Desc)], map: "idx_report_queue")
  @@index([reportedEntityType, reportedEntityId], map: "idx_report_entity")
  @@index([assignedModeratorId, status], map: "idx_report_assigned")
  @@map("report")
  @@schema("moderation")
}

// Aggregate root (docs/ddd/moderation-trust-safety.md "ModerationAction"):
// one independently-revocable rung on the graduated enforcement ladder
// (`warn`/`mute`/`suspend`/`ban`) issued against a target Person. Duration
// invariant 1 (`warn`/`ban` never time-boxed) and invariant 3 (a `ban` is
// always `org`-scoped regardless of report origin) are enforced defensively
// at the database level via the two hand-authored CHECK constraints in this
// migration's SQL, in addition to the `TakeModerationAction` application
// service's own authority/duration validation (a later stage). Invariant 5
// (multiple `active` actions may coexist against the same target — no
// "current sanction level" collapse) is a deliberate absence of any unique
// constraint on `(targetPersonId, status)`, matching the doc exactly.
model ModerationAction {
  id                  String                 @id
  actionType          ModerationActionType   @map("action_type")
  targetPersonId      String                 @map("target_person_id")
  moderatorPersonId   String                 @map("moderator_person_id")
  reason              String
  relatedReportId     String?                @map("related_report_id")
  scopeType           ModerationScopeType    @map("scope_type")
  scopeId             String?                @map("scope_id")
  startsAt            DateTime               @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt              DateTime?              @map("ends_at") @db.Timestamptz(6)
  status              ModerationActionStatus @default(active)
  revokedByPersonId   String?                @map("revoked_by_person_id")
  revokedAt           DateTime?              @map("revoked_at") @db.Timestamptz(6)
  revokeReason        String?                @map("revoke_reason")
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  relatedReport   Report?  @relation("ModerationActionRelatedReport", fields: [relatedReportId], references: [id], onDelete: SetNull)
  resolvedReports Report[] @relation("ReportResolutionAction")

  @@index([targetPersonId, status, startsAt(sort: Desc)], map: "idx_moderation_action_target")
  @@index([scopeType, scopeId, startsAt(sort: Desc)], map: "idx_moderation_action_scope")
  @@map("moderation_action")
  @@schema("moderation")
}

// ---------------------------------------------------------------------------
// Phase 8 — Notifications: schema only (Notification, NotificationPreference,
// DeliveryAttempt, plus the inbound-event idempotency ledger for the five
// event-consumer jobs a later stage builds)
// ---------------------------------------------------------------------------
//
// The Notification, NotificationPreference, and DeliveryAttempt shapes from
// docs/ddd/notifications.md, matching that doc's own Schema Sketch
// field-for-field. `notifications.domain_events`
// (`NotificationsDomainEvent`, above) already exists from Phase 1; this
// phase adds the three aggregate/entity tables plus the inbound-event
// idempotency ledger. No use cases, no event consumers, no API, no Resend
// integration in this migration — those are a later stage; this migration
// is data model only.
//
// `recipient_person_id` (Notification) and `person_id`
// (NotificationPreference) are intentional soft references (plain columns,
// no relation, no FK) to `identity.persons.id` — cross-schema, so no FK is
// possible or wanted, per the Schema Sketch's own comments and ADR-0001.
// `DeliveryAttempt.notificationId` IS a real, same-schema FK (no explicit
// `onDelete` in the Schema Sketch's literal DDL, so Prisma's default
// `ON DELETE RESTRICT` applies) because `Notification` and `DeliveryAttempt`
// are both owned by this same `notifications` schema — the
// no-cross-schema-FK rule applies only at bounded-context boundaries, not
// within one.
//
// Unlike every prior phase's status/kind/type columns, this schema's own
// Schema Sketch deliberately does NOT back `channel` (on both Notification
// and NotificationPreference) or `status` (DeliveryAttempt) with Postgres
// enums — its literal DDL writes each as plain `TEXT NOT NULL CHECK (... IN
// (...))`. `Notification.type` and `NotificationPreference.type` are
// likewise plain text with no CHECK at all, an application-enforced closed
// set (see docs/ddd/notifications.md's own "Notification Type" ubiquitous-
// language entry) — deliberately not a DB enum "to avoid a migration every
// time a new source event is wired up," same convention as
// `identity.consent_record.purpose` (ADR-0014). Modeled here as plain
// `String` fields to match, with every CHECK constraint the sketch specifies
// hand-authored in the migration SQL (no stable `@@check` attribute in this
// Prisma version) — same precedent as every other hand-authored CHECK
// constraint already in this file's earlier phases.
//
// Several constructs in the Schema Sketch have no Prisma-schema-language
// equivalent and are hand-authored in the migration SQL instead — same
// precedent as every hand-authored addition already in this file's earlier
// phases:
//   - `chk_notification_channel`, `chk_notification_source_context`,
//     `chk_notification_preference_channel`, `chk_delivery_attempt_channel`,
//     and `chk_delivery_attempt_status` CHECK constraints — the exact five
//     inline CHECKs the Schema Sketch itself writes (see the header note
//     above for why these are plain TEXT + CHECK rather than enums).
//   - `notification_unread_idx`, the partial index on
//     `(recipient_person_id, created_at DESC) WHERE in_app_read_at IS NULL`
//     backing "list my unread notifications" (Key Use Case 6,
//     `ListUnread`) — Prisma's schema language has no partial-index syntax.
//   - `delivery_attempt_pending_idx`, the partial index on `(created_at)
//     WHERE status = 'pending' AND channel = 'email'` backing the
//     graphile-worker drain query for `ProcessDeliveryJob` — same reason.
//   - `delivery_attempt_provider_message_uq`, the partial unique index on
//     `provider_message_id WHERE provider_message_id IS NOT NULL` backing
//     Resend webhook correlation (`HandleResendWebhook`, Key Use Case 7) —
//     same reason.
//
// `notifications.processed_events` (`NotificationsProcessedEvent` below) is
// not part of docs/ddd/notifications.md's own Schema Sketch — that doc's
// Integration & Anti-Corruption Notes instead describe idempotency as a
// per-source-schema `processed_at` column update on the *source* context's
// own `domain_events` row (no ledger table in this schema at all). This
// migration adds one anyway, per this stage's own explicit brief, mirroring
// the `gamification.processed_events` / `community.processed_events`
// precedent (ADR-0009's idempotent-consumer pattern) for the five
// per-source-schema consumer jobs a later stage builds
// (`consumeVolunteeringEvents`, `consumeTrainingEvents`,
// `consumeGamificationEvents`, `consumeCommunityEvents`,
// `consumeModerationEvents` — one per source schema
// listed in the "Consumed" event table, not one per event type). Keyed by a
// single `id` column (the origin `domain_events.id`, a ULID, already
// globally unique on its own — same as `community.processed_events`), with
// `sourceContext` and `eventType` carried alongside for traceability, same
// shape and reasoning as `CommunityProcessedEvent` above. This is
// deliberately NOT `packages/outbox`'s generic `(consumer, event_id)`
// template: each of the five jobs is this context's single logical consumer
// for its one source schema, not several independent consumers draining the
// same table. `Notification`'s own `(source_event_id, recipient_person_id)`
// unique index (invariant 2) is a second, independent line of defense
// against a duplicate `Notification` row specifically; this ledger is the
// general per-event idempotency gate a handler checks (and inserts into,
// same transaction) before doing any work at all, including the
// zero-row-created "suppressed" outcome that invariant 2's index alone
// cannot idempotency-gate (a suppressed event leaves no `Notification` row
// to collide on if reprocessed).

// Aggregate root (docs/ddd/notifications.md "Notification"): the unit of
// "this person needs to know X," created once per (recipient, source
// event), never mutated except `in_app_read_at`. Invariant 2 (idempotent by
// source event) is the unique index below; invariant 1 (never created or
// delivered for an opted-out (person, type, channel)) and invariant 3
// (payload is an immutable snapshot) are enforced at the application layer
// (`QueueNotification`/`ProcessDeliveryJob`, a later stage), not
// expressible as DDL.
model Notification {
  id                String    @id
  recipientPersonId String    @map("recipient_person_id")
  type              String
  payload           Json      @default("{}")
  channel           String
  inAppReadAt       DateTime? @map("in_app_read_at") @db.Timestamptz(6)
  sourceContext     String    @map("source_context")
  sourceEventId     String    @map("source_event_id")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  deliveryAttempts DeliveryAttempt[]

  @@unique([sourceEventId, recipientPersonId], map: "notification_source_event_recipient_uq")
  @@index([recipientPersonId, createdAt(sort: Desc)], map: "notification_recipient_created_idx")
  @@map("notification")
  @@schema("notifications")
}

// Entity (docs/ddd/notifications.md "NotificationPreference"): one row per
// (person, type, channel), governing whether `QueueNotification` includes
// that channel in the effective set for that person and type. Absence of a
// row means the type/channel's documented default applies
// (`packages/shared/src/notificationDefaults.ts`, a later stage) — this
// table only ever stores explicit overrides.
model NotificationPreference {
  id        String   @id
  personId  String   @map("person_id")
  type      String
  channel   String
  enabled   Boolean  @default(true)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([personId, type, channel])
  @@index([personId], map: "notification_preference_person_idx")
  @@map("notification_preference")
  @@schema("notifications")
}

// Entity, child of `Notification` (docs/ddd/notifications.md
// "DeliveryAttempt"): one row per attempt to deliver a `Notification` over
// one channel. A `Notification` with `channel = 'both'` produces two
// independent `DeliveryAttempt` lineages, each with its own retry history.
// `in_app` delivery is created and immediately marked `sent` in the same
// transaction as the `Notification` write (`attemptedAt = createdAt`);
// `email` delivery starts `pending` and is picked up by
// `ProcessDeliveryJob` — both a later stage's job, not this migration's.
model DeliveryAttempt {
  id                String    @id
  notificationId    String    @map("notification_id")
  channel           String
  status            String    @default("pending")
  providerMessageId String?   @map("provider_message_id")
  attemptedAt       DateTime? @map("attempted_at") @db.Timestamptz(6)
  retryCount        Int       @default(0) @map("retry_count")
  errorMessage      String?   @map("error_message")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  notification Notification @relation(fields: [notificationId], references: [id])

  @@index([notificationId, attemptedAt(sort: Desc)], map: "delivery_attempt_notification_idx")
  @@map("delivery_attempt")
  @@schema("notifications")
}

// Idempotent inbound-event consumption ledger (ADR-0009), added per this
// stage's own explicit brief rather than docs/ddd/notifications.md's own
// Schema Sketch — see the header comment above for the full reasoning and
// how this differs from `packages/outbox`'s generic `(consumer, event_id)`
// template. A later stage's five per-source-schema consumer jobs each
// attempt an insert here inside the same transaction as any resulting
// `Notification`/`DeliveryAttempt` writes (including the no-row-created
// "suppressed" outcome); a primary-key conflict means the event was already
// processed and the transaction no-ops.
model NotificationsProcessedEvent {
  id            String   @id
  sourceContext String   @map("source_context")
  eventType     String   @map("event_type")
  processedAt   DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@map("processed_events")
  @@schema("notifications")
}

// ---------------------------------------------------------------------------
// Phase 9 — Admin & Reporting: schema additions (ReportDefinition, ExportJob)
// ---------------------------------------------------------------------------
//
// The ReportDefinition and ExportJob aggregates from docs/ddd/admin-
// reporting.md, matching that doc's own Schema Sketch field-for-field.
// `admin.audit_log` (`AuditLog`) and `admin.domain_events`
// (`AdminDomainEvent`) already exist from Phase 1 (see above) and are not
// touched by this migration. `admin.retention_policies` is NOT added here —
// it is not yet present in this schema despite being summarized in the DDD
// doc's "RetentionPolicy" entity section for schema completeness; adding it
// is out of this stage's own explicit Build list (report_definition and
// export_job only) and is left for whichever later stage actually builds
// the retention_sweep job. No use cases, no event consumers, no API in this
// migration — those are a later stage; this migration is data model only.
//
// `created_by_person_id` (ReportDefinition) and `requested_by_person_id`
// (ExportJob) are intentional soft references (plain columns, no relation,
// no FK) to `identity.person.id` — cross-schema, so no FK is possible or
// wanted, per the Schema Sketch's own comments and ADR-0001.
// `ExportJob.identityDsarRequestId` is likewise a soft reference to
// `identity.dsar_requests.id` — no FK, per the Schema Sketch's own comment
// ("no FK") and ADR-0014's orchestration-as-a-command boundary (Integration
// & Anti-Corruption Notes: "DSAR orchestration is a command, not a data
// pipe").
// `ExportJob.reportDefinitionId` IS a real, same-schema FK (no explicit
// `onDelete` in the Schema Sketch's literal DDL, so Prisma's default
// applies) because `ReportDefinition` and `ExportJob` are both owned by
// this same `admin` schema — the no-cross-schema-FK rule applies only at
// bounded-context boundaries, not within one.
//
// Matching the Schema Sketch's own literal DDL exactly, `type`, `status`,
// and `output_file_format` are plain `TEXT NOT NULL`/`TEXT` with inline
// `CHECK (... IN (...))` constraints, not Postgres enums — same convention
// already used for `notifications.notification.channel`/
// `delivery_attempt.status` (see that phase's own header note): an
// application-enforced closed set that avoids a migration every time a new
// job type/status is added, and the sketch itself writes `CHECK` inline
// rather than `CREATE TYPE`. Every CHECK constraint below is hand-authored
// in the migration SQL (no stable `@@check` attribute in this Prisma
// version) — same precedent as every other hand-authored CHECK constraint
// already in this file's earlier phases.
//
// `group_by` and `output_formats` are `TEXT[]`, same `String[]` Prisma
// mapping already established by `volunteering.opportunity.skills_required`
// / `prerequisite_course_ids` — no enum, no join table, matching the
// sketch's literal `TEXT[]` columns.
//
// The two partial indexes the Schema Sketch specifies
// (`export_job_active_idx` on `(status, created_at) WHERE status IN
// ('queued','running')`, and `export_job_dsar_request_idx` on
// `(identity_dsar_request_id) WHERE identity_dsar_request_id IS NOT NULL`)
// have no Prisma-schema-language equivalent and are hand-authored in the
// migration SQL only, intentionally with no `@@index` counterpart here —
// same precedent as every other hand-authored partial index already in
// this file's earlier phases.

// Aggregate root (docs/ddd/admin-reporting.md "ReportDefinition"): a saved,
// reusable report configuration. `hourlyValuationRateCents` is per-
// definition, never a global config value, so different reports can use
// different rates simultaneously and a rate edit never silently rewrites
// the meaning of a report someone is about to run — see the load-bearing
// snapshot invariant on `ExportJob.params` below, which is what actually
// makes an already-completed report immune to this column ever changing.
model ReportDefinition {
  id                       String   @id
  name                     String
  description              String?
  reportType               String   @map("report_type")
  filters                  Json     @default("{}")
  groupBy                  String[] @default([]) @map("group_by")
  hourlyValuationRateCents Int      @default(3614) @map("hourly_valuation_rate_cents")
  currency                 String   @default("USD")
  outputFormats            String[] @default(["csv", "pdf"]) @map("output_formats")
  isActive                 Boolean  @default(true) @map("is_active")
  createdByPersonId        String   @map("created_by_person_id")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  exportJobs ExportJob[]

  @@index([isActive, createdAt(sort: Desc)], map: "report_definition_active_idx")
  @@map("report_definition")
  @@schema("admin")
}

// Aggregate root (docs/ddd/admin-reporting.md "ExportJob"): one concrete,
// executed (or in-flight) export — immutable once `completed`/`failed`, a
// new run is always a new row, never a re-opened one (invariant 3).
// Invariant 1, the snapshotted-valuation-rate rule ("params.
// hourlyValuationRateCents is fixed at RequestExportJob time... the dollar
// figures in a downloaded grant packet never silently change meaning after
// the fact"), lives entirely in `params` (JSONB, copied at request time,
// never re-read live from `ReportDefinition`) — there is no DB-level
// mechanism that could enforce "never changes after the fact" beyond
// invariant 3's terminal-state immutability, which this schema also does
// not defensively trigger-enforce (unlike `admin.audit_log`'s insert-only
// trigger) because, per the sketch, ordinary application code is the sole
// writer of this table and the invariant is a write-time discipline
// (`ProcessExportJob`/`OrchestrateDsarRequest` only ever write a row from
// `queued` through to a single terminal transition), not a defense against
// an adversarial or buggy caller the way the audit log's insert-only rule
// is.
model ExportJob {
  id                     String    @id
  type                   String
  status                 String    @default("queued")
  reportDefinitionId     String?   @map("report_definition_id")
  requestedByPersonId    String    @map("requested_by_person_id")
  params                 Json      @default("{}")
  identityDsarRequestId  String?   @map("identity_dsar_request_id")
  outputFileKey          String?   @map("output_file_key")
  outputFileFormat       String?   @map("output_file_format")
  outputFileExpiresAt    DateTime? @map("output_file_expires_at") @db.Timestamptz(6)
  rowCount               Int?      @map("row_count")
  errorMessage           String?   @map("error_message")
  startedAt              DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt            DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  reportDefinition ReportDefinition? @relation(fields: [reportDefinitionId], references: [id])

  @@index([requestedByPersonId, createdAt(sort: Desc)], map: "export_job_requested_by_idx")
  @@map("export_job")
  @@schema("admin")
}

// ---------------------------------------------------------------------------
// Phase 9 — Admin & Reporting: retention_policies + admin's own processed_events
// ---------------------------------------------------------------------------
//
// `admin.retention_policies` is ADR-0014 §3's table, restated (not
// re-designed) here — the prior migration's own header comment explicitly
// left it out ("left for whichever later stage actually builds the
// retention_sweep job"); this is that stage. `updated_by` is a soft
// reference to `identity.person.id` (ADR-0014's own literal DDL writes it
// as `references identity.users(id)`, but this schema has no
// `identity.users` table — `identity.persons` is this codebase's Person
// table — and, more importantly, a cross-schema FK is exactly what every
// other admin table's own comments already reject; a plain, unvalidated
// TEXT column matches `report_definition.created_by_person_id` /
// `export_job.requested_by_person_id`'s established "by ID only, no FK"
// convention instead of the ADR's own illustrative FK).
//
// `admin.processed_events` is this schema's own idempotency ledger for
// `consumeIdentityDsarEvents` (`OrchestrateDsarRequest`'s completion
// consumer) — the exact same single-consumer-per-source-schema shape
// `notifications.processed_events` (`NotificationsProcessedEvent`, above)
// already established, not `packages/outbox`'s generic `(consumer,
// event_id)` ledger: `admin` has exactly one logical external consumer
// (identity's DSAR completion events), the same "one job per source
// schema" shape notifications' own header comment documents.
model RetentionPolicy {
  id            String    @id
  dataClass     String    @unique @map("data_class")
  retentionDays Int       @map("retention_days")
  action        String
  enabled       Boolean   @default(true)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?   @map("updated_by")

  @@map("retention_policies")
  @@schema("admin")
}

model AdminProcessedEvent {
  id            String   @id
  sourceContext String   @map("source_context")
  eventType     String   @map("event_type")
  processedAt   DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@map("processed_events")
  @@schema("admin")
}
